# Copy to .env and fill in. .env is gitignored.

# --- Web 服务 ---
PORT=8080

# 谁来选歌。external（默认，留空也一样）：不调用 Claude，不自动选歌、不定时推歌、
# 队列播完就停。选歌交给外部 bot（Grok Bot / Claudio主持人）。
# internal：恢复开机电台、聊天选歌和定时推歌。
CLAUDIO_BRAIN=external

# 从没保存过音量时用这个值（0–100）。滑块、/vol、控制接口改过之后以保存值为准。
CLAUDIO_DEFAULT_VOLUME=30

# 监听地址。默认只绑本机回环，局域网和公网都连不上。
# 要给另一台机器上的 bot 调用时再改成 0.0.0.0，并且必须同时设置 CLAUDIO_API_TOKEN。
CLAUDIO_HOST=127.0.0.1

# 非本机来源访问 /api/*、/tts/* 和 WebSocket /stream 时的令牌。
# CLAUDIO_REQUIRE_TOKEN 关闭时，本机浏览器（127.0.0.1 / ::1）不校验这个值。
# 留空则拒绝一切非回环请求。不要把真实 token 写进仓库。
CLAUDIO_API_TOKEN=

# 默认关。设为 1 / true / on / yes 后，连 127.0.0.1 也必须带令牌
# （反代或内网穿透把外网流量转到本机时，回环免检会被绕过）。
# 打开前必须先填 CLAUDIO_API_TOKEN，否则本机也会 401。
# 本机 PWA：浏览器打开一次 http://127.0.0.1:8080/?token=你的令牌 。
# 服务核对令牌后种 HttpOnly、SameSite=Strict 的 cookie（值是随机会话 id，不是令牌本身）。
# 回环免检和旧 cookie 都不能签发新会话。
# 页面随后从地址栏去掉 token。之后 fetch、<audio>、WebSocket 都靠这个 cookie。
# 静态页面里不写密钥。服务重启后要再打开一次带 token 的地址。
CLAUDIO_REQUIRE_TOKEN=

# Host 白名单，逗号分隔，防 DNS 重绑定。
# 默认已放行 localhost、127.0.0.1、[::1]（带不带端口都行）。
# 局域网 IP 或穿透域名写在这里，例如 192.168.1.20,radio.example.com
# 写成 host:port 时只放行该端口。WebSocket 的 Origin 用同一份名单。
CLAUDIO_ALLOWED_HOSTS=

# --- 酷狗音乐 ---
# 上游 KuGouMusicApi 地址；npm run dev 会自动等待它 ready 后再启动 Claudio
KUGOU_API_BASE=http://localhost:3000
# KuGouMusicApi 仓库目录；默认是 Claudio 同级的 ../KuGouMusicApi
KUGOU_API_DIR=../KuGouMusicApi

# 出站代理。Clash（尤其 fake-ip）把直连酷狗网关掉时，填它的本地 HTTP 端口。
# 例：http://127.0.0.1:7890
# 留空则直连。本机 KuGouMusicApi 以及任何 127.0.0.1 / localhost / ::1 都不会走这个代理。
# npm run dev 会把它传给 KuGouMusicApi 的 KUGOU_API_PROXY。
# 上游 axios 不读 HTTP_PROXY / HTTPS_PROXY，只读 KUGOU_API_PROXY（或 --proxy）。
KUGOU_PROXY=

# 自动登录用（推荐）。手机号 + 密码
KUGOU_USERNAME=
KUGOU_PASSWORD=

# 或者：直接贴 cookie（如果你不想用自动登录）
# 在浏览器登录 kugou.com 后，从开发者工具 Application → Cookies 复制
KUGOU_COOKIE=

# token 后台续期间隔（小时）。默认 24。
# 上游提醒「不要频繁调登录接口,不然可能会被风控」，所以只在距上次成功续期超过
# 该间隔时才调一次 /login/token —— 不是每次启动都调。
KUGOU_REFRESH_INTERVAL_HOURS=24

# --- DeepSeek API（推荐，比 claude -p 快 3-5x）---
# 填了这个就走 DeepSeek，否则回退到 claude -p
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Claude CLI（没有 DeepSeek key 时的兜底）---
# Claude 子进程超时（毫秒）
CLAUDE_TIMEOUT_MS=60000

# 上下文里最近多少条历史
CONTEXT_HISTORY_N=20

# --- 环境注入：天气 ---
# https://openweathermap.org/api 注册免费 key
OPENWEATHER_API_KEY=
# 城市名（OpenWeather 接受英文）。留空默认 Shanghai
OPENWEATHER_CITY=Shanghai

# --- 环境注入：飞书日历 ---
# 使用本机 lark-cli（需先 `lark-cli auth login`）。无需在此填值。

# --- Fish Audio TTS ---
# 在 https://fish.audio 拿 API key。未配置时 say 字段不会语音化（不报错）。
FISH_API_KEY=
# 用哪个声音模型的 reference_id（在 Fish 控制台的 Voice 详情页）。
FISH_VOICE_ID=
