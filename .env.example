# Copy to .env and fill in. .env is gitignored.

# --- Web 服务 ---
PORT=8080

# --- 酷狗音乐 ---
# 上游 KuGouMusicApi 独立服务的地址（你单独启动）
KUGOU_API_BASE=http://localhost:3000

# 自动登录用（推荐）。手机号 + 密码
KUGOU_USERNAME=
KUGOU_PASSWORD=

# 或者：直接贴 cookie（如果你不想用自动登录）
# 在浏览器登录 kugou.com 后，从开发者工具 Application → Cookies 复制
KUGOU_COOKIE=

# token 自动续期间隔（小时）。默认 12。token 实测 2-3 天过期，不建议超过 24。
KUGOU_REFRESH_INTERVAL_HOURS=12

# --- 网络 / 代理安全（/api/proxy 拉流）---
# 默认只放行酷狗系域名，且一律拦截内网 / 保留地址（防 SSRF + DNS rebinding）。
# 追加额外放行的域名后缀（逗号分隔）
PROXY_ALLOWED_HOSTS=
# 若代理工具（Clash / mihomo / Surge）开了 TUN + fake-IP，酷狗 CDN 会被解析到
# 198.18.0.0/15 这类保留网段而被拦，表现为日志刷「DNS 解析到内网地址，已拦截」。
# 把你的 fake-ip-range 填进来即可放行；留空 = 不信任（默认）。
PROXY_TRUST_FAKE_IP_CIDRS=
# 危险：PROXY_ALLOW_ANY_HOST=1 会关掉域名白名单（内网拦截仍然生效），不建议。

# --- DeepSeek API（推荐，比 claude -p 快 3-5x）---
# 填了这个就走 DeepSeek，否则回退到 claude -p
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Claude CLI（没有 DeepSeek key 时的兜底）---
# Claude 子进程超时（毫秒）
CLAUDE_TIMEOUT_MS=60000

# 上下文里最近多少条历史
CONTEXT_HISTORY_N=20

# --- 环境注入：天气 ---
# https://openweathermap.org/api 注册免费 key
OPENWEATHER_API_KEY=
# 城市名（OpenWeather 接受英文）。留空默认 Shanghai
OPENWEATHER_CITY=Shanghai

# --- 环境注入：飞书日历 ---
# 使用本机 lark-cli（需先 `lark-cli auth login`）。无需在此填值。

# --- Fish Audio TTS ---
# 在 https://fish.audio 拿 API key。未配置时 say 字段不会语音化（不报错）。
FISH_API_KEY=
# 用哪个声音模型的 reference_id（在 Fish 控制台的 Voice 详情页）。
FISH_VOICE_ID=
