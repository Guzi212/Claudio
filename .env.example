# Copy to .env and fill in. .env is gitignored.

# --- Web 服务 ---
PORT=8080

# --- 酷狗音乐 ---
# 上游 KuGouMusicApi 独立服务的地址（你单独启动）
KUGOU_API_BASE=http://localhost:3000

# 自动登录用（推荐）。手机号 + 密码
KUGOU_USERNAME=
KUGOU_PASSWORD=

# 或者：直接贴 cookie（如果你不想用自动登录）
# 在浏览器登录 kugou.com 后，从开发者工具 Application → Cookies 复制
KUGOU_COOKIE=

# --- Claude CLI ---
# Claude 子进程超时（毫秒）
CLAUDE_TIMEOUT_MS=15000

# 上下文里最近多少条历史
CONTEXT_HISTORY_N=20
